# 复制成 .env 后按服务器环境调整；这些都是可覆盖的部署默认值。
BASE_IMAGE=pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime
APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ubuntu
# 默认安全更新也走国内源；重视同步时效时改为 https://security.ubuntu.com/ubuntu。
APT_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ubuntu
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=0
MODEL_CACHE_DIR=./models
MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
GPU_ID=0
BIND_ADDRESS=0.0.0.0
HOST_PORT=18765
DEFAULT_VOICE=Vivian
DEFAULT_LANGUAGE=Auto
DTYPE=bfloat16
ATTN_IMPLEMENTATION=sdpa
MAX_INPUT_CHARS=2000
STREAM_CHUNK_SIZE=8

# 启动阶段状态日志间隔（秒）；缓存大小不代表模型下载百分比。
LOG_LEVEL=INFO
STARTUP_LOG_INTERVAL=30

# 每个源最多尝试两次，每次最长 900 秒；官方不可达也会超时退出。
HF_FALLBACK_TO_OFFICIAL=1
HF_HUB_DISABLE_XET=1
HF_HUB_DOWNLOAD_TIMEOUT=30
MODEL_DOWNLOAD_ATTEMPTS=2
MODEL_DOWNLOAD_TIMEOUT=900
MODEL_DOWNLOAD_WORKERS=4
# 推荐使用提交哈希固定版本；main 默认优先复用已经准备好的缓存。
MODEL_REVISION=main

# 可选：配合 qwen3-tts-local.override.yml，指向完整本地模型目录。
# HOST_MODEL_DIR=/absolute/path/to/Qwen3-TTS-12Hz-1.7B-CustomVoice

# 可选：配合 qwen3-tts-token.override.yml，指向仅含 Token 的服务器文件。
# HF_TOKEN_HOST_FILE=/absolute/path/to/hf-token
